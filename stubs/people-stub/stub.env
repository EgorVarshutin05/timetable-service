# Начальные режимы people-stub (читает docker-compose.yml через env_file). На лету меняются через PUT /__stub/config.
# Задержка каждого предметного ответа, мс — основа async-кейса.
STUB_LATENCY_MS=300
# Идентификаторы, на которые заглушка отвечает 500: преподаватель I4 и аудитория C4.
STUB_FAIL_IDS=1b000000-0000-4000-8000-000000000004,2c000000-0000-4000-8000-000000000004
# Идентификаторы, ответ по которым задерживается на 10 с: преподаватель I5 и аудитория C5.
STUB_TIMEOUT_IDS=1b000000-0000-4000-8000-000000000005,2c000000-0000-4000-8000-000000000005
# 1 — все предметные ответы и /health отвечают 503.
STUB_DOWN=0
